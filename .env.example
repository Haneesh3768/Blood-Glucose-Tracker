# ==============================================================================
# Sweety Monorepo - Global Environment Variables Template
# Copy this file to .env or configure respective server/.env and client/.env
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=sweety_admin
POSTGRES_PASSWORD=sweety_secure_dev_password
POSTGRES_DB=sweety_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sweety_admin:sweety_secure_dev_password@localhost:5432/sweety_db?schema=public

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Authentication Secrets (Generate secure 32+ character hex strings in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Client Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
