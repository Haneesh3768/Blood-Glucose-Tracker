{
  "openapi": "3.0.3",
  "info": {
    "title": "Sweety – Blood Glucose Tracker API",
    "version": "1.0.0",
    "description": "Production-grade, clinical personal blood glucose tracking REST API. Implements JWT access & opaque refresh tokens with session family revocation, strict multi-tenant isolation, composite constraints, and complete reading lifecycle management."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "15-minute stateless JWT access token obtained via /api/v1/auth/login or /api/v1/auth/register."
      }
    },
    "schemas": {
      "TimeSlot": {
        "type": "string",
        "enum": [
          "Morning (fasting)",
          "After breakfast",
          "After lunch",
          "After dinner",
          "MORNING",
          "MORNING_FASTING",
          "AFTER_BREAKFAST",
          "AFTER_LUNCH",
          "AFTER_DINNER"
        ],
        "description": "Blood glucose time slot. Normalized to canonical clinical display slots."
      },
      "Reading": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "example": "d1e2f3a4-5678-90ab-cdef-1234567890ab"
          },
          "readingDate": {
            "type": "string",
            "format": "date",
            "example": "2026-10-15"
          },
          "timeSlot": {
            "$ref": "#/components/schemas/TimeSlot"
          },
          "glucoseValue": {
            "type": "integer",
            "minimum": 40,
            "maximum": 600,
            "example": 105,
            "description": "Blood glucose level in mg/dl."
          },
          "value": {
            "type": "integer",
            "example": 105,
            "description": "Backward compatibility alias for glucoseValue."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "userId", "readingDate", "timeSlot", "glucoseValue", "createdAt", "updatedAt"]
      },
      "CreateReadingInput": {
        "type": "object",
        "properties": {
          "readingDate": {
            "type": "string",
            "format": "date",
            "example": "2026-10-15",
            "description": "Calendar date (YYYY-MM-DD). Cannot be in the future."
          },
          "timeSlot": {
            "$ref": "#/components/schemas/TimeSlot"
          },
          "glucoseValue": {
            "type": "integer",
            "minimum": 40,
            "maximum": 600,
            "example": 115,
            "description": "Whole integer glucose measurement between 40 and 600 mg/dl."
          },
          "value": {
            "type": "integer",
            "example": 115,
            "description": "Alias for glucoseValue."
          }
        },
        "required": ["readingDate", "timeSlot"]
      },
      "PatchReadingInput": {
        "type": "object",
        "properties": {
          "readingDate": {
            "type": "string",
            "format": "date",
            "example": "2026-10-15"
          },
          "timeSlot": {
            "$ref": "#/components/schemas/TimeSlot"
          },
          "glucoseValue": {
            "type": "integer",
            "minimum": 40,
            "maximum": 600,
            "example": 125
          },
          "value": {
            "type": "integer",
            "example": 125
          }
        },
        "description": "Partial update payload. At least one field must be provided."
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "total": { "type": "integer", "example": 38 },
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 20 },
          "totalPages": { "type": "integer", "example": 2 },
          "hasNextPage": { "type": "boolean", "example": true },
          "hasPreviousPage": { "type": "boolean", "example": false }
        },
        "required": ["total", "page", "limit", "totalPages", "hasNextPage", "hasPreviousPage"]
      },
      "ReportStats": {
        "type": "object",
        "properties": {
          "highest": { "type": "number", "nullable": true, "example": 142 },
          "lowest": { "type": "number", "nullable": true, "example": 90 },
          "average": { "type": "number", "nullable": true, "example": 123.8 },
          "count": { "type": "integer", "example": 4 },
          "totalReadings": { "type": "integer", "example": 4 }
        },
        "required": ["highest", "lowest", "average", "count", "totalReadings"]
      },
      "ReportResult": {
        "type": "object",
        "properties": {
          "reportType": { "type": "string", "enum": ["daily", "month-to-date", "monthly"] },
          "selectedDate": { "type": "string", "format": "date", "example": "2026-10-15" },
          "dateRange": {
            "type": "object",
            "properties": {
              "startDate": { "type": "string", "format": "date", "example": "2026-10-15" },
              "endDate": { "type": "string", "format": "date", "example": "2026-10-15" }
            },
            "required": ["startDate", "endDate"]
          },
          "stats": { "$ref": "#/components/schemas/ReportStats" },
          "readings": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Reading" }
          },
          "isEmpty": { "type": "boolean", "example": false }
        },
        "required": ["reportType", "selectedDate", "dateRange", "stats", "readings", "isEmpty"]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string", "example": "Value must be between 40 and 600 mg/dl." },
          "details": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["success", "error"]
      }
    }
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register a new patient account",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "Jane Doe" },
                  "email": { "type": "string", "format": "email", "example": "patient@sweety.app" },
                  "password": { "type": "string", "minLength": 8, "example": "Password123!" }
                },
                "required": ["name", "email", "password"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Account created. Sets HTTP-only refresh cookie." },
          "400": { "description": "Validation failed." },
          "409": { "description": "Email already registered." }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Log in with email and password",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "patient@sweety.app" },
                  "password": { "type": "string", "example": "Password123!" }
                },
                "required": ["email", "password"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authenticated. Returns access token and sets HTTP-only refresh cookie." },
          "401": { "description": "Invalid credentials (constant error to prevent enumeration)." }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "summary": "Rotate refresh token and issue new access token",
        "tags": ["Authentication"],
        "responses": {
          "200": { "description": "Tokens rotated." },
          "401": { "description": "Invalid or revoked token (family revoked upon reuse)." }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Revoke current refresh token and clear cookie",
        "tags": ["Authentication"],
        "responses": {
          "200": { "description": "Session revoked." }
        }
      }
    },
    "/api/v1/readings": {
      "post": {
        "summary": "Create a new blood glucose reading",
        "tags": ["Readings"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReadingInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reading created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Reading created successfully." },
                    "data": {
                      "type": "object",
                      "properties": {
                        "reading": { "$ref": "#/components/schemas/Reading" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error (value out of range, future date, 4-readings-per-day limit).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "401": { "description": "Unauthorized." },
          "409": {
            "description": "Duplicate slot on specified date.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List paginated blood glucose readings for authenticated user",
        "tags": ["Readings"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1, "minimum": 1 },
            "description": "Page number."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20, "minimum": 1, "maximum": 100 },
            "description": "Number of readings per page (max 100)."
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Filter by exact date (YYYY-MM-DD)."
          },
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Filter range start date (YYYY-MM-DD)."
          },
          {
            "name": "endDate",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Filter range end date (YYYY-MM-DD)."
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of user readings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "readings": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Reading" }
                        },
                        "pagination": { "$ref": "#/components/schemas/PaginationMeta" }
                      }
                    },
                    "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid query parameters." },
          "401": { "description": "Unauthorized." }
        }
      }
    },
    "/api/v1/readings/{id}": {
      "get": {
        "summary": "Retrieve a single reading by ID (scoped to authenticated user)",
        "tags": ["Readings"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Reading UUID."
          }
        ],
        "responses": {
          "200": {
            "description": "Reading details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "reading": { "$ref": "#/components/schemas/Reading" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized." },
          "404": { "description": "Reading not found (or does not belong to user)." }
        }
      },
      "patch": {
        "summary": "Partially update a reading by ID",
        "tags": ["Readings"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Reading UUID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchReadingInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reading updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Reading updated successfully." },
                    "data": {
                      "type": "object",
                      "properties": {
                        "reading": { "$ref": "#/components/schemas/Reading" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error." },
          "401": { "description": "Unauthorized." },
          "404": { "description": "Reading not found." },
          "409": { "description": "Slot collision on date." }
        }
      },
      "delete": {
        "summary": "Delete a reading by ID",
        "tags": ["Readings"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Reading UUID."
          }
        ],
        "responses": {
          "200": {
            "description": "Reading deleted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string", "example": "Reading deleted successfully." },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized." },
          "404": { "description": "Reading not found." }
        }
      }
    },
    "/api/v1/reports/daily": {
      "get": {
        "summary": "Get Daily Glucose Report for a calendar date",
        "tags": ["Reports"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date", "example": "2026-10-15" },
            "description": "Selected calendar date (YYYY-MM-DD). Defaults to today in UTC."
          }
        ],
        "responses": {
          "200": {
            "description": "Daily statistical metrics and detailed slot breakdown.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "report": { "$ref": "#/components/schemas/ReportResult" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid date format." },
          "401": { "description": "Unauthorized." }
        }
      }
    },
    "/api/v1/reports/month-to-date": {
      "get": {
        "summary": "Get Month-to-Date (MTD) Glucose Report",
        "tags": ["Reports"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date", "example": "2026-10-15" },
            "description": "Selected end date (YYYY-MM-DD). Scope runs from 1st of month to this date."
          }
        ],
        "responses": {
          "200": {
            "description": "MTD statistical aggregations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "report": { "$ref": "#/components/schemas/ReportResult" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid date format." },
          "401": { "description": "Unauthorized." }
        }
      }
    },
    "/api/v1/reports/monthly": {
      "get": {
        "summary": "Get Monthly Report for the entire previous calendar month",
        "tags": ["Reports"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date", "example": "2026-10-15" },
            "description": "Selected anchor date (YYYY-MM-DD). Report aggregates the entire previous calendar month."
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly report metrics for the full previous month.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "report": { "$ref": "#/components/schemas/ReportResult" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid date format." },
          "401": { "description": "Unauthorized." }
        }
      }
    },
    "/api/v1/reports/summary": {
      "get": {
        "summary": "Get statistical glucose report (Daily, MTD, Monthly)",
        "tags": ["Reports"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["daily", "mtd", "monthly"] }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": { "description": "Aggregated report stats (highest, lowest, average, count)." },
          "400": { "description": "Invalid query parameters." },
          "401": { "description": "Unauthorized." }
        }
      }
    }
  }
}

